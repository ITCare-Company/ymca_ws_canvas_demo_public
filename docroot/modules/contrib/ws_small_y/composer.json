{
    "name": "drupal/ws_small_y",
    "type": "drupal-module",
    "description": "A collection of modules to customize the appearance and functionality of the distribution for small Ys.",
    "keywords": ["Drupal", "Small Y"],
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/ws_small_y",
    "require": {
        "php": ">=8.1",
        "ycloudyusa/y_lb": ">=3.9.5 || ~4.0.0",
        "drupal/bootstrap_layout_builder": "*",
        "drupal/layout_builder_restrictions": "^2.16 || ^3.0",
        "drupal/link_attributes": "^2.1",
        "drupal/openy_gtranslate": "^1 || ^2.0.0",
        "drupal/entity_browser": "^2.11",
        "drupal/inline_entity_form": "^2.0 || ^2.0@RC || ^3.0@RC",
        "drupal/lb_staff_members_blocks": "^1.2.5 || ~1.3.0"
    },
    "support": {
        "issues": "https://www.drupal.org/project/issues/ws_small_y",
        "source": "https://git.drupalcode.org/project/ws_small_y"
    },
    "extra": {
        "patches": {
            "drupal/search_api": {
                "#3209441 Excerpt fields are not rendered for anonymous users": "https://www.drupal.org/files/issues/2024-08-21/3209441-23--cache_metadata_search_api_excerpt_field.patch",
                "#3284807 Incorrect Search API (tag-based) cached excerpt highlighting for subsequent search with a different term but same result items": "https://www.drupal.org/files/issues/2023-10-29/3284807-12--fix_tag_based_caching_highlighted_fields.patch"
            }
        }
    }
}
