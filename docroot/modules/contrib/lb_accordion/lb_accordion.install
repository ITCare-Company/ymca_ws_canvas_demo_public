  $path = \Drupal::service('extension.list.module')->getPath('lb_accordion') . '/config/outdated/2.1.4';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'core.entity_form_display.block_content.lb_accordion.default',
    'core.entity_view_display.block_content.lb_accordion.default',
    'field.field.block_content.lb_accordion.field_section_subtitle',
    'field.storage.block_content.field_section_subtitle',
  ]);
}
