/**
 * Move values from 'field_event_location' field to 'field_location_reference'.
 */
function ws_event_update_9014(&$sandbox) {
  $nodes = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->loadByProperties([
      'type' => 'lb_event',
    ]);

  foreach ($nodes as $node) {
    $node->set('field_location_reference', $node->get('field_event_location')->getValue());
    try {
      $node->save();
    }
    catch (EntityStorageException $e) {
    }
  }
}

/**
 * Remove field instance field_event_location.
 */
function ws_event_update_9015(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('ws_event') . '/config/outdated/1.2.2';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'core.entity_form_display.node.lb_event.default',
    'core.entity_view_display.node.lb_event.default',
    'core.entity_view_display.node.lb_event.featured',
    'core.entity_view_display.node.lb_event.teaser',
  ]);

  FieldConfig::loadByName('node', 'lb_event', 'field_event_location')?->delete();
}

