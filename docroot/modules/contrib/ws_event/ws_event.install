/**
 * Add sub-blocks to denylisted_blocks for the layout builder.
 */
function ws_event_update_9017(&$sandbox) {
  $config_path = \Drupal::service('extension.list.module')->getPath('ws_event') . '/config/outdated/1.3.11/';
  $config_importer = \Drupal::service('openy_upgrade_tool.param_updater');
  $config = 'core.entity_view_display.node.lb_event.default';
  $config_importer->update(
    $config_path . $config . '.yml',
    $config,
    'third_party_settings.layout_builder_restrictions.entity_view_mode_restriction.denylisted_blocks'
  );
}

/**
 * Fix view sort order.
 */
function ws_event_update_9018(&$sandbox) {
  // In the standard profile these module not enabled, so enable them.
  $module_handler = \Drupal::moduleHandler();
  ;
  if (!$module_handler->moduleExists('verf')) {
    \Drupal::service('module_installer')->install(['verf'], FALSE);
  }

  if (!$module_handler->moduleExists('better_exposed_filters')) {
    \Drupal::service('module_installer')->install(['better_exposed_filters'], FALSE);
  }
  $path = \Drupal::service('extension.list.module')->getPath('ws_event') . '/config/outdated/1.3.11';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'field.storage.node.field_blog_description',
    'views.view.listing_events',
  ]);
}

