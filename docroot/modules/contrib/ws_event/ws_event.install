/**
 * Update start/end date meta tags.
 */
function ws_event_update_9022(&$sandbox) {
  $config_path = \Drupal::service('extension.list.module')->getPath('ws_event') . '/config/outdated/1.4.15/';
  $config_importer = \Drupal::service('openy_upgrade_tool.param_updater');
  $config = 'metatag.metatag_defaults.node__lb_event';
  $properties = [
    'tags.schema_event_start_date',
    'tags.schema_event_end_date'
  ];
  foreach ($properties as $property) {
    $config_importer->update(
      $config_path . $config . '.yml',
      $config,
      $property
    );
  }
}

