/**
 * Implements hook_update_dependencies().
 */
function ws_event_update_dependencies() {
  $dependencies['y_lb'][9011] = [
    'ws_event' => 9016,
  ];

  $dependencies['y_lb_article'][9009] = [
    'ws_event' => 9016,
  ];

  return $dependencies;
}

/**
 * Add address for event info block.
 */
function ws_event_update_9001(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('ws_event') . '/config/outdated/1.0.28';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'field.field.node.lb_event.field_location_address',
    'field.field.node.lb_event.field_location_directions',
    'field.field.node.lb_event.field_event_location',
    'core.entity_form_display.node.lb_event.default',
    'core.entity_view_display.node.lb_event.default',
    'core.entity_view_display.node.lb_event.teaser',
  ]);
}

