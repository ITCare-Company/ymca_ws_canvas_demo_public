  ]);
}

/**
 * (Don't) Add a new field Trimmed limit.
 */
function lb_cards_update_9008() {
  // This field has been removed so the update hook should be ignored.
  // Keeping it here for posterity.
  \Drupal::logger('upgrade')->warning(
    'field_trimmed_limit: This field was removed in later versions.
    Check lb_cards_update_9008 if you need to keep it. See https://www.drupal.org/i/3450452 for details.'
  );
}

/**
 * Change field type for Description field (again).
 */
function lb_cards_update_9009() {
  $fields = [
    'field_body' => [
      'table' => 'block_content__field_body',
      'revision_table' => 'block_content_revision__field_body',
      'new_field_name' => 'field_description',
      'new_field_table' => 'block_content__field_description',
      'new_field_revision_table' => 'block_content_revision__field_description'
    ],
  ];

  $database = \Drupal::database();

  foreach ($fields as $field_name => $f) {
    $table = $f['table'];
    $revision_table = $f['revision_table'];
    $new_field_name = $f['new_field_name'];
    $new_field_table = $f['new_field_table'];
    $new_field_revision_table = $f['new_field_revision_table'];
    // Entity type here.
    $entity_type = 'block_content';
    $current_bundle = 'card_item';

    // Step 1: Get field storage.
    $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);

    // Check if field not found.
    if (is_null($field_storage)) {
      continue;
    }

    // Step 2: Store data.
    $rows = NULL;
    $revision_rows = NULL;
    if ($database->schema()->tableExists($table)) {
      // The table data to restore after the update is completed.
      $rows = $database->select($table, 'n')
        ->condition('bundle', $current_bundle)
        ->fields('n')
        ->execute()
        ->fetchAll();
      $revision_rows = $database->select($revision_table, 'n')
        ->condition('bundle', $current_bundle)
        ->fields('n')
        ->execute()
        ->fetchAll();
    }

    // Step 3: Save new field configs & delete existing fields.
    $new_fields = array();
    foreach ($field_storage->getBundles() as $bundle => $label) {
      if ($bundle === $current_bundle) {
        $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
        $new_field = $field->toArray();
        $new_field['field_name'] = $new_field_name;
        $new_field['field_type'] = 'text_long';
        $new_fields[] = $new_field;
        // Delete field.
        $field->delete();
      }
    }

    // Step 4: Create new storage configs from existing.
    $new_field_storage = $field_storage->toArray();
    $new_field_storage['type'] = 'text_long';
    $new_field_storage['module'] = 'text';

    // Step 5: Purge deleted fields data.
    // This is required to create new fields.
    field_purge_batch(250);

    // Step 6: Create new fieldstorage.
    if (!(FieldStorageConfig::loadByName($entity_type, $new_field_name) instanceof FieldStorageConfig)) {
      FieldStorageConfig::create($new_field_storage)->save();
    }

    // Step 7: Create new fields for all bundles.
    foreach ($new_fields as $new_field) {
      $new_field = FieldConfig::create($new_field);
      $new_field->save();
    }

    // Step 8: Restore existing data in fields & revision tables.
    if (!is_null($rows)) {
      foreach ($rows as $row) {
        $row = (array) $row;
        $row['field_description_format'] = 'full_html';
        $row['field_description_value'] = '<p>'.implode('</p><p>', preg_split('/\r\n|\r|\n/', $row['field_body_value'])).'</p>';
        unset($row['field_body_value']);
        $database->insert($new_field_table)->fields($row)->execute();
      }
    }
    if (!is_null($revision_rows)) {
      foreach ($revision_rows as $row) {
        $row = (array) $row;
        $row['field_description_format'] = 'full_html';
        $row['field_description_value'] = '<p>'.implode('</p><p>', preg_split('/\r\n|\r|\n/', $row['field_body_value'])).'</p>';
        unset($row['field_body_value']);
        $database->insert($new_field_revision_table)->fields($row)->execute();
      }
    }
  }
}

/**
 * Update configs with new type of Description field.
 */
function lb_cards_update_9010(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('lb_cards') . '/config/outdated/2.0.15';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');

  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'core.entity_form_display.block_content.card_item.default',
    'core.entity_view_display.block_content.card_item.default',
  ]);

  // Remove the old field_body from the card_item bundle.
  // Do not delete it because it may be used by other bundles.
  FieldConfig::loadByName('block_content', 'card_item', 'field_body')?->delete();
}

/**
 * Remove field Trimmed limit.
 */
function lb_cards_update_9011() {
  $entity_type = 'block_content';
  $bundle = 'card_item';
  $field_name = 'field_trimmed_limit';

  // Delete the field if it exists.
  if ($field_config = FieldConfig::loadByName($entity_type, $bundle, $field_name)) {
    $field_config->delete();
  }

  // Delete the field storage if it exists.
  if ($field_storage = FieldStorageConfig::loadByName($entity_type, $field_name)) {
    $field_storage->delete();
  }

  // Purge deleted fields data.
  field_purge_batch(250);

  // Import updated config.
  $path = \Drupal::service('extension.list.module')->getPath('lb_cards') . '/config/optional';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'core.entity_form_display.block_content.card_item.default',
    'core.entity_view_display.block_content.card_item.default',
  ]);
}

