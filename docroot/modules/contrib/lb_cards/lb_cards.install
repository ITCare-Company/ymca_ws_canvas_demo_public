/**
 * Import config to create 'card_item' sub block for 'lb_cards' block.
 */
function lb_cards_update_9004(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('lb_cards') . '/config/outdated/2.0.1';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'block_content.type.card_item',
    'core.entity_form_display.block_content.card_item.default',
    'core.entity_view_display.block_content.card_item.default',
    'field.field.block_content.card_item.field_body',
    'field.field.block_content.card_item.field_cta',
    'field.field.block_content.card_item.field_media',
    'field.field.block_content.card_item.field_title',
    'field.field.block_content.card_item.field_topic_tag',
    'field.field.block_content.lb_cards.field_block_item',
    'field.storage.block_content.field_block_item',
    'field.storage.block_content.field_body',
    'field.storage.block_content.field_media',
    'field.storage.block_content.field_title',
    'field.storage.block_content.field_topic_tag',
    'language.content_settings.block_content.card_item',
  ]);
}

/**
 * Migrate content from 'lb_card' paragraph to 'card_item' block.
 */
function lb_cards_update_9005(&$sandbox) {
  /** @var \Drupal\Core\Entity\EntityTypeManager $entityTypeManager */
  $entityTypeManager = \Drupal::entityTypeManager();
  $storageParagraph = $entityTypeManager->getStorage('paragraph');
  $storageBlock = $entityTypeManager->getStorage('block_content');
  if (!isset($sandbox['progress'])) {
    $sandbox['progress'] = 0;
    $sandbox['data'] = [
      'paragraphs' => $storageParagraph->loadByProperties(['type' => 'lb_card']),
      'blocks' => []
    ];
    // Group paragraphs by parent id.
    foreach ($sandbox['data']['paragraphs'] as $id => $paragraph) {
      $sandbox['data']['blocks'][$paragraph->get('parent_id')->value][] = $id;
    }
    $sandbox['total'] = count($sandbox['data']['blocks']);
  }

  $blocks = array_slice($sandbox['data']['blocks'], $sandbox['progress'], 5, true);

  foreach ($blocks as $parentId => $paragraphIds) {
    $newBlockIds = [];

    foreach ($paragraphIds as $paragraphId) {
      $paragraph = $sandbox['data']['paragraphs'][$paragraphId];
      // Create new 'carousel_item' sub block with content from paragraph
      $block = $storageBlock->create([
        'type' => 'card_item',
        'field_body' => $paragraph->get('field_card_description')->getValue(),
        'field_title' => $paragraph->get('field_card_title')->getValue(),
        'field_media' => $paragraph->get('field_card_image')->getValue(),
        'field_cta' => $paragraph->get('field_card_cta')->getValue(),
        'field_topic_tag' => $paragraph->get('field_card_topic_tag')->getValue(),
      ]);

      $block->save();
      $newBlockIds[] = $block->id();
      $paragraph->delete();
    }

    // Load parent block and set new sub block.
    /** @var \Drupal\block_content\Entity\BlockContent $parentBlock */
    if (($parentBlock = $storageBlock->load($parentId)) && $parentBlock->bundle() === 'lb_cards') {
      $parentBlock->set('field_block_item', $newBlockIds)->save();
    }
    $sandbox['progress']++;
  }

  $sandbox['#finished'] = empty($sandbox['total']) ? 1 : $sandbox['progress'] / $sandbox['total'];
}

/**
 * Remove 'lb_card' paragraph
 */
function lb_cards_update_9006(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('lb_cards') . '/config/outdated/2.0.1';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');

  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'core.entity_form_display.block_content.lb_cards.default',
    'core.entity_view_display.block_content.lb_cards.default',
  ]);

  $configsToDelete = [
    'paragraphs.paragraphs_type.lb_card',
    'core.entity_form_display.paragraph.lb_card.default',
    'core.entity_view_display.paragraph.lb_card.default',
  ];

  $configFactory = \Drupal::configFactory();
  foreach ($configsToDelete as $config) {
    $configFactory->getEditable($config)->delete();
  }

  FieldConfig::loadByName('paragraph', 'lb_card', 'field_card_title')?->delete();
  FieldConfig::loadByName('paragraph', 'lb_card', 'field_card_image')?->delete();
  FieldConfig::loadByName('paragraph', 'lb_card', 'field_card_description')?->delete();
  FieldConfig::loadByName('paragraph', 'lb_card', 'field_card_cta')?->delete();
  FieldConfig::loadByName('paragraph', 'lb_card', 'field_card_topic_tag')?->delete();
  FieldConfig::loadByName('block_content', 'lb_cards', 'field_cards')?->delete();

  FieldStorageConfig::loadByName('paragraph', 'field_card_title')?->delete();
  FieldStorageConfig::loadByName('paragraph', 'field_card_image')?->delete();
  FieldStorageConfig::loadByName('paragraph', 'field_card_description')?->delete();
  FieldStorageConfig::loadByName('paragraph', 'field_card_cta')?->delete();
  FieldStorageConfig::loadByName('paragraph', 'field_card_topic_tag')?->delete();
  FieldStorageConfig::loadByName('block_content', 'field_cards')?->delete();
}

