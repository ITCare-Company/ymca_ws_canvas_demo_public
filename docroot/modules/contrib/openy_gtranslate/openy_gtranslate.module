<?php
/**
 * @file
 * Defines the Open Y Google Translate module functions.
 */

/**
 * Implements hook_theme().
 */
function openy_gtranslate_theme($existing, $type, $theme, $path) {
  return [
    'openy_gtranslate' => [
      'variables' => [
        'in_preview' => FALSE,
        'in_preview_placeholder' => NULL,
      ],
    ],
  ];
}
