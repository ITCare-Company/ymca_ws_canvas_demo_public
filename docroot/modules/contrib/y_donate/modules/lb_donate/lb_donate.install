<?php

/**
 * @file
 * Contains install and update functions for Y Layout Builder - Donate module.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Set Background image field to not required.
 */
function lb_donate_update_9000(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('lb_donate') . '/config/optional';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'field.field.block_content.lb_donate.field_image',
  ]);
}

/**
 * Require giving amount label and element id.
 */
function lb_donate_update_9001(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('lb_donate') . '/config/optional';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
    'field.field.paragraph.lb_donate_giving_amount.field_amount_label',
    'field.field.paragraph.lb_donate_giving_amount.field_form_element_id',
  ]);
}

/**
 * Require CTA field too.
 */
function lb_donate_update_9002(&$sandbox) {
  $path = \Drupal::service('extension.list.module')->getPath('lb_donate') . '/config/optional';
  /** @var \Drupal\config_import\ConfigImporterService $config_importer */
  $config_importer = \Drupal::service('config_import.importer');
  $config_importer->setDirectory($path);
  $config_importer->importConfigs([
