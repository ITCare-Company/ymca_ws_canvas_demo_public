  $component = new SectionComponent($uuid_service->generate(), 'header_bottom_right', [
    'id' => 'system_menu_block:account',
    'label' => 'User account menu',
    'label_display' => '0',
    'provider' => 'system',
    'level' => '1',
    'depth' => '0',
    'expand_all_items' => FALSE,
  ]);
