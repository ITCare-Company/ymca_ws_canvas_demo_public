{#
/**
 * Y Card Item component.
 *
 * Variables:
 * - title: (string) Card heading (required)
 * - description: (string) Card description (HTML)
 * - image: (object) Card image with src, alt, width, height
 * - cta_text: (string) Link text
 * - cta_url: (string) Link URL
 * - tag: (string) Category tag
 * - heading_level: (string) h3, h4, h5
 */
#}

{% set heading_level = heading_level|default('h3') %}

{% set classes = [
  'y-card-item',
  image.src ? 'y-card-item--has-image' : 'y-card-item--no-image',
] %}

<article {{ attributes.addClass(classes) }} data-component="y-card-item">
  {% if image.src %}
    <div class="y-card-item__image-wrapper">
      <img
        src="{{ image.src }}"
        alt="{{ image.alt|default('') }}"
        class="y-card-item__image"
        loading="lazy"
        {% if image.width %}width="{{ image.width }}"{% endif %}
        {% if image.height %}height="{{ image.height }}"{% endif %}
      />
      {% if tag %}
        <span class="y-card-item__tag">{{ tag }}</span>
      {% endif %}
    </div>
  {% endif %}

  <div class="y-card-item__content">
    {% if tag and not image.src %}
      <span class="y-card-item__tag y-card-item__tag--inline">{{ tag }}</span>
    {% endif %}

    <{{ heading_level }} class="y-card-item__title">
      {% if cta_url %}
        <a href="{{ cta_url }}" class="y-card-item__title-link">
          {{ title }}
        </a>
      {% else %}
        {{ title }}
      {% endif %}
    </{{ heading_level }}>

    {% if description %}
      <div class="y-card-item__description">
        {{ description|raw }}
      </div>
    {% endif %}

    {% if cta_text and cta_url %}
      <div class="y-card-item__footer">
        <a href="{{ cta_url }}" class="y-card-item__cta">
          {{ cta_text }}
          <svg class="y-card-item__cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</article>
