{#
/**
 * Y Testimonials component.
 *
 * Variables:
 * - title: (string) Section heading
 * - subtitle: (string) Section subheading
 * - autoplay: (boolean) Auto-rotate testimonials
 * - show_controls: (boolean) Show navigation
 * - heading_level: (string) h2, h3, h4
 *
 * Slots:
 * - items: Testimonial item components
 */
#}

{% set heading_level = heading_level|default('h2') %}
{% set autoplay = autoplay ?? true %}
{% set show_controls = show_controls ?? true %}
{% set carousel_id = 'y-testimonials-' ~ random() %}

{% set classes = [
  'y-testimonials',
] %}

<section {{ attributes.addClass(classes) }}
         data-component="y-testimonials"
         {% if autoplay %}data-autoplay="true"{% endif %}>

  {% if title or subtitle %}
    <div class="y-testimonials__header">
      {% if title %}
        {% if heading_level == 'h2' %}
          <h2 class="y-testimonials__title">{{ title }}</h2>
        {% elseif heading_level == 'h3' %}
          <h3 class="y-testimonials__title">{{ title }}</h3>
        {% elseif heading_level == 'h4' %}
          <h4 class="y-testimonials__title">{{ title }}</h4>
        {% else %}
          <h2 class="y-testimonials__title">{{ title }}</h2>
        {% endif %}
      {% endif %}

      {% if subtitle %}
        <p class="y-testimonials__subtitle">{{ subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="y-testimonials__carousel" id="{{ carousel_id }}">
    <div class="y-testimonials__track">
      {{ items }}
    </div>

    {% if show_controls %}
      <div class="y-testimonials__controls">
        <button class="y-testimonials__prev" aria-label="Previous testimonial">
          <span class="y-testimonials__arrow">&#8249;</span>
        </button>
        <button class="y-testimonials__next" aria-label="Next testimonial">
          <span class="y-testimonials__arrow">&#8250;</span>
        </button>
      </div>

      <div class="y-testimonials__indicators"></div>
    {% endif %}
  </div>
</section>
