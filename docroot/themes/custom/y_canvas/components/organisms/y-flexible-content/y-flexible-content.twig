{#
/**
 * Y Flexible Content component.
 *
 * Variables:
 * - title: (string) Section heading
 * - layout: (string) Column layout
 * - background: (string) Background color variant
 * - content: (slot) Content blocks
 */
#}

{% set classes = [
  'y-flexible-content',
  layout ? 'y-flexible-content--' ~ layout : 'y-flexible-content--single',
  background ? 'y-flexible-content--bg-' ~ background : '',
] %}

<section {{ attributes.addClass(classes) }} data-component="y-flexible-content">
  <div class="y-flexible-content__container">
    {% if title %}
      <h2 class="y-flexible-content__title">{{ title }}</h2>
    {% endif %}
    <div class="y-flexible-content__content">
      {{ content }}
    </div>
  </div>
</section>
