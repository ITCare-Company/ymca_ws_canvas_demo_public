{#
/**
 * Y Menu Block component.
 *
 * Variables:
 * - title: (string) Block heading
 * - menu_name: (string) Machine name of menu
 * - depth: (integer) Menu depth level
 * - display_style: (string) Display variant
 * - menu: (slot) Menu items
 */
#}

{% set classes = [
  'y-menu-block',
  display_style ? 'y-menu-block--' ~ display_style : 'y-menu-block--vertical',
] %}

<nav {{ attributes.addClass(classes) }} data-component="y-menu-block" aria-label="{{ title|default('Navigation') }}">
  {% if title %}
    <h3 class="y-menu-block__title">{{ title }}</h3>
  {% endif %}
  <div class="y-menu-block__menu">
    {{ menu }}
  </div>
</nav>
